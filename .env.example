# Copy to .env (docker compose reads it automatically).

# RustFS root credentials, also used by the tracker to talk to it. Choose your own values:
#   openssl rand -hex 16
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# Image tag to run: latest, a release like 1.2.3, or edge (main branch)
# GHG_VERSION=latest
# Port the UI is published on
# GHG_PORT=8000

# OCR engine and CPU threads, see README
# GHG_OCR_ENGINE=ppocr6-tiny
# GHG_OCR_THREADS=2
